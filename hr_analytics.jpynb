============>]  50.11K  --.-KB/s    in 0s      \n","\n","2026-11-11 16:11:43 (126 MB/s) - ‘netflix-dataset.zip’ saved [51314/51314]\n","\n","['WA_Fn-UseC_-HR-Employee-Attrition.csv']\n"]}],"source":["import os\n","import zipfile\n","import sqlite3\n","import pandas as pd\n","import numpy as np\n","import matplotlib.pyplot as plt\n","\n","os.makedirs(\"dataset_folder\", exist_ok=True)\n","\n","!wget -O netflix-dataset.zip \"https://www.kaggle.com/api/v1/datasets/download/pavansubhasht/ibm-hr-analytics-attrition-dataset\"\n","\n","with zipfile.ZipFile(\"netflix-dataset.zip\", \"r\") as zip_ref:\n","    zip_ref.extractall(\"dataset_folder\")\n","\n","print(os.listdir(\"dataset_folder\"))\n","\n","df = pd.read_csv(\"/content/dataset_folder/WA_Fn-UseC_-HR-Employee-Attrition.csv\")"]},{"cell_type":"code","source":["# Analyze MonthlyIncome by Department, JobRole, JobLevel, Gender (median, not mean)\n","\n","income_by_department = df.groupby('Department')['MonthlyIncome'].median()\n","income_by_jobrole = df.groupby('JobRole')['MonthlyIncome'].median().sort_values(ascending=False)\n","income_by_joblevel = df.groupby('JobLevel')['MonthlyIncome'].median()\n","income_by_gender = df.groupby('Gender')['MonthlyIncome'].median()\n","\n","print(income_by_department)\n","print(income_by_jobrole)\n","print(income_by_joblevel)\n","print(income_by_gender)\n","\n","plt.style.use('dark_background')\n","\n","fig, ax = plt.subplots(figsize=(8, 5))\n","bars = ax.bar(income_by_department.index, income_by_department.values, color='steelblue')\n","ax.bar_label(bars, fmt='%.0f')\n","ax.set_title('Median Monthly Income by Department')\n","ax.set_xlabel('Department')\n","ax.set_ylabel('Median Monthly Income ($)')\n","plt.tight_layout()\n","plt.show()"],"metadata":{"id":"4N2lnJv1xp2i","colab":{"base_uri":"https://localhost:8080/","height":642},"executionInfo":{"status":"ok","timestamp":1794413864840,"user_tz":-240,"elapsed":298,"user":{"displayName":"Salima Dadashova","userId":"02015391648946278492"}},"outputId":"f344c722-7daf-4bd1-91a3-cc2495433306"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Department\n","Human Resources           3886.0\n","Research & Development    4374.0\n","Sales                     5754.5\n","Name: MonthlyIncome, dtype: float64\n","JobRole\n","Manager                      17454.5\n","Research Director            16510.0\n","Healthcare Representative     6811.0\n","Manufacturing Director        6447.0\n","Sales Executive               6231.0\n","Human Resources               3093.0\n","Research Scientist            2887.5\n","Laboratory Technician         2886.0\n","Sales Representative          2579.0\n","Name: MonthlyIncome, dtype: float64\n","JobLevel\n","1     2670.0\n","2     5340.0\n","3     9980.0\n","4    16154.0\n","5    19232.0\n","Name: MonthlyIncome, dtype: float64\n","Gender\n","Female    5081.5\n","Male      4837.5\n","Name: MonthlyIncome, dtype: float64\n"]},{"output_type":"display_data","data":{"text/plain":["<Figure size 800x500 with 1 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"code","source":["pivot_income = df.pivot_table(\n","    index='Department',\n","    columns='JobLevel',\n","    values='MonthlyIncome',\n","    aggfunc='median'\n",")\n","\n","print(\"--- Department x JobLevel (Median Monthly Income) ---\")\n","print(pivot_income)"],"metadata":{"id":"5hUBDQiqaFpP","colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"status":"ok","timestamp":1794417805258,"user_tz":-240,"elapsed":48,"user":{"displayName":"Salima Dadashova","userId":"02015391648946278492"}},"outputId":"28295bc6-10ec-4949-f5b4-9923b78cd19a"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["--- Department x JobLevel (Median Monthly Income) ---\n","JobLevel                     1       2        3        4        5\n","Department                                                       \n","Human Resources         2696.0  5985.0   9853.0  16618.0  19189.0\n","Research & Development  2693.0  5228.0  10312.0  16370.5  19237.0\n","Sales                   2553.0  5423.0   9250.0  15699.5  19068.0\n"]}]},{"cell_type":"code","source":["js_counts = df['JobSatisfaction'].value_counts().sort_index()\n","js_percent = df['JobSatisfaction'].value_counts(normalize=True).sort_index() * 100\n","\n","overall_js = pd.DataFrame({\n","    'Employee Count': js_counts,\n","    'Percentage (%)': js_percent.round(2)\n","})\n","\n","print(\"=== Overall JobSatisfaction Distribution (1-4) ===\")\n","print(overall_js)\n","\n","dept_js_dist = pd.crosstab(df['Department'], df['JobSatisfaction'], normalize='index') * 100\n","print(\"\\nJob Satisfaction Distribution by Department (%):\\n\", round(dept_js_dist, 2))"],"metadata":{"id":"rvMKffGJo-W2","colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"status":"ok","timestamp":1794421052342,"user_tz":-240,"elapsed":6,"user":{"displayName":"Salima Dadashova","userId":"02015391648946278492"}},"outputId":"f48d08d5-a923-4946-d319-2673d9d2c2ce"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["=== Overall JobSatisfaction Distribution (1-4) ===\n","                 Employee Count  Percentage (%)\n","JobSatisfaction                                \n","1                           289           19.66\n","2                           280           19.05\n","3                           442           30.07\n","4                           459           31.22\n","\n","Job Satisfaction Distribution by Department (%):\n"," JobSatisfaction             1      2      3      4\n","Department                                        \n","Human Resources         17.46  31.75  23.81  26.98\n","Research & Development  19.98  18.11  31.22  30.70\n","Sales                   19.28  19.28  28.48  32.96\n"]}]},{"cell_type":"code","source":["# Analyze WorkLifeBalance distribution (1–4) by Department\n","dept_wlb_dist = pd.crosstab(df['Department'], df['WorkLifeBalance'], normalize='index') * 100\n","print(round(dept_wlb_dist, 2))"],"metadata":{"id":"oQ3O7Zj77Bkw","colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"status":"ok","timestamp":1794425587232,"user_tz":-240,"elapsed":6,"user":{"displayName":"Salima Dadashova","userId":"02015391648946278492"}},"outputId":"35f3bff9-6eb8-4071-a32d-e91d7ed2e7cf"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["WorkLifeBalance            1      2      3      4\n","Department                                       \n","Human Resources         6.35  11.11  66.67  15.87\n","Research & Development  6.24  24.45  59.83   9.47\n","Sales                   3.59  22.87  61.88  11.66\n"]}]},{"cell_type":"code","source":["# Calculate % of employees scoring JobSatisfaction = 1 or 2 per Department (low satisfaction flag)\n","low_js_df = df[df['JobSatisfaction'].isin([1, 2])]\n","low_js_percent = (low_js_df.groupby('Department').size() / df.groupby('Department').size()) * 100\n","print(round(low_js_percent, 2))"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"pcrnpYdEGTXd","executionInfo":{"status":"ok","timestamp":1794425582704,"user_tz":-240,"elapsed":17,"user":{"displayName":"Salima Dadashova","userId":"02015391648946278492"}},"outputId":"49b557b5-54e3-4e6c-fe97-4de3aeac579f"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Department\n","Human Resources           49.21\n","Research & Development    38.09\n","Sales                     38.57\n","dtype: float64\n"]}]},{"cell_type":"code","source":["# Compare OverTime=Yes vs No: avg JobSatisfaction and avg WorkLifeBalance\n","ot_comparison = df.groupby('OverTime')[['JobSatisfaction', 'WorkLifeBalance']].mean()\n","print(round(ot_comparison, 2))"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"exB64ZAbGWgM","executionInfo":{"status":"ok","timestamp":1794426136144,"user_tz":-240,"elapsed":10,"user":{"displayName":"Salima Dadashova","userId":"02015391648946278492"}},"outputId":"5397863a-f80a-4bc5-86b7-f6540293cb4c"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["          JobSatisfaction  WorkLifeBalance\n","OverTime                                  \n","No                   2.71             2.77\n","Yes                  2.77             2.73\n"]}]},{"cell_type":"code","source":["# Correlate: MonthlyIncome, YearsAtCompany, PercentSalaryHike, JobLevel, TrainingTimesLastYear with JobSatisfaction\n","corr_vars = ['MonthlyIncome', 'YearsAtCompany', 'PercentSalaryHike', 'JobLevel', 'TrainingTimesLastYear', 'JobSatisfaction']\n","correlations = df[corr_vars].corr()['JobSatisfaction']\n","print(correlations)"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"qTr8Mmd2Ikbo","executionInfo":{"status":"ok","timestamp":1794426249708,"user_tz":-240,"elapsed":21,"user":{"displayName":"Salima Dadashova","userId":"02015391648946278492"}},"outputId":"1f2cc582-fa8f-4a0c-df88-bb85554f60fc"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["MonthlyIncome           -0.007157\n","YearsAtCompany          -0.003803\n","PercentSalaryHike        0.020002\n","JobLevel                -0.001944\n","TrainingTimesLastYear   -0.005779\n","JobSatisfaction          1.000000\n","Name: JobSatisfaction, dtype: float64\n"]}]},{"cell_type":"code","source":["# Median income by Department (Bar Chart)\n","\n","dept_income = df.groupby('Department')['MonthlyIncome'].median()\n","\n","plt.figure(figsize=(8, 5))\n","dept_income.plot(kind='bar', color=['skyblue', 'salmon', 'lightgreen'])\n","plt.title('Median Monthly Income by Department')\n","plt.xlabel('Department')\n","plt.ylabel('Median Monthly Income ($)')\n","plt.xticks(rotation=0)\n","plt.show()"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":145},"id":"eFNrRU2Mdcp8","executionInfo":{"status":"ok","timestamp":1794431803055,"user_tz":-240,"elapsed":337,"user":{"displayName":"Salima Dadashova","userId":"02015391648946278492"}},"outputId":"2bfb9359-9d3e-4489-d480-5169c3fa9776"},"execution_count":24,"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 800x500 with 1 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"code","source":["# JobLevel × Department income (Heatmap əvəzinə təmiz Matplotlib ilə Matris / Bar)\n","\n","heatmap_data = df.pivot_table(index='Department', columns='JobLevel', values='MonthlyIncome', aggfunc='median')\n","\n","plt.figure(figsize=(10, 5))\n","for dept in heatmap_data.index:\n","    plt.plot(heatmap_data.columns, heatmap_data.loc[dept], marker='o', label=dept)\n","plt.title('Median Monthly Income by Job Level and Department')\n","plt.xlabel('Job Level')\n","plt.ylabel('Median Monthly Income ($)')\n","plt.legend()\n","plt.grid(True)\n","plt.show()"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":121},"id":"QM9VZ3LKdhNJ","executionInfo":{"status":"ok","timestamp":1794431862375,"user_tz":-240,"elapsed":625,"user":{"displayName":"Salima Dadashova","userId":"02015391648946278492"}},"outputId":"053816c0-86f5-4c69-b908-fc071ffe55cb"},"execution_count":25,"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 1000x500 with 1 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"code","source":["# JobSatisfaction distribution bar per Department (%)\n","js_dept = pd.crosstab(df['Department'], df['JobSatisfaction'], normalize='index') * 100\n","\n","plt.figure(figsize=(10, 5))\n","js_dept.plot(kind='bar', figsize=(10, 5))\n","plt.title('Job Satisfaction Distribution per Department (%)')\n","plt.xlabel('Department')\n","plt.ylabel('Percentage (%)')\n","plt.legend(title='Job Satisfaction')\n","plt.xticks(rotation=0)\n","plt.show()"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":160},"id":"tL4DEkAqdnmI","executionInfo":{"status":"ok","timestamp":1794431723482,"user_tz":-240,"elapsed":377,"user":{"displayName":"Salima Dadashova","userId":"02015391648946278492"}},"outputId":"61743707-e637-4ea1-8c06-5822b112eb16"},"execution_count":22,"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 1000x500 with 0 Axes>"]},"metadata":{}},{"output_type":"display_data","data":{"text/plain":["<Figure size 1000x500 with 1 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"code","source":["# WorkLifeBalance distribution (Pie Chart)\n","wlb_counts = df['WorkLifeBalance'].value_counts().sort_index()\n","labels = ['1 - Bad', '2 - Good', '3 - Better', '4 - Best']\n","\n","plt.figure(figsize=(6, 6))\n","plt.pie(wlb_counts, labels=labels, autopct='%1.1f%%', startangle=140)\n","plt.title('Overall Work-Life Balance Distribution')\n","plt.show()"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":198},"id":"-oXsUJN6dzAW","executionInfo":{"status":"ok","timestamp":1794431749849,"user_tz":-240,"elapsed":296,"user":{"displayName":"Salima Dadashova","userId":"02015391648946278492"}},"outputId":"9da9a243-3a57-46c7-bd02-8a077c21edac"},"execution_count":23,"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 600x600 with 1 Axes>"],"image/png":"\n"},"metadata":{}}]}]}